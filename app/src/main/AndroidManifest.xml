<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stitch merges this manifest into the target app's at patch time, so the
         paywall no longer has to assume the host already holds INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Do NOT declare the provider here. Stitch adds it itself, with the
         authority scoped to the target's package; declaring it here as well
         would either be skipped by the merger or register an unscoped
         authority that collides across patched apps. -->
    <application tools:ignore="MissingApplicationIcon" />

</manifest>
